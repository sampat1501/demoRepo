        "Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned; $env:PATHEXT += ';.PY'; Set-Location 'd:\\GenAI'; & 'd:\\GenAI\\.venv\\Scripts\\Activate.ps1'"
